---
import BaseLayout from './BaseLayout.astro';
import Byline from '../components/Byline.astro';
import NetworkLinks from '../components/NetworkLinks.astro';

interface Props {
  title: string;
  /**
   * Concise SERP title for the <title>/OG/schema name, kept under ~60 chars.
   * The visible <h1> always uses the full narrative `title`; this only trims
   * what search engines show. Falls back to `title` when not set.
   */
  seoTitle?: string;
  description?: string;
  /**
   * Tight meta description (~150–160 chars) for the SERP snippet, OG and schema.
   * The visible lede under the <h1> always uses the full `description`; this only
   * trims what search engines and social cards show. Falls back to `description`.
   */
  seoDescription?: string;
  kicker?: string;
  status?: string;
  author?: string;
  updated?: string;
  reviewed?: boolean;
  thread?: string;
  about?: Array<{ name: string; type?: string; sameAs?: string[] }>;
}

const { title, seoTitle, description, seoDescription, kicker, status, author, updated, reviewed, thread, about } =
  Astro.props;
---

<BaseLayout
  title={seoTitle ?? title}
  description={seoDescription ?? description}
  pageType="article"
  dateModified={updated ?? '2026'}
  about={about}
>
  <article class="mx-auto max-w-3xl px-6 py-16">
    <header class="border-b border-[var(--border)] pb-8">
      {
        kicker && (
          <p class="font-mono text-xs uppercase tracking-[0.2em] text-[var(--accent)]">
            {kicker}
          </p>
        )
      }
      <h1 class="mt-3 text-balance font-serif text-4xl leading-tight font-semibold tracking-tight">
        {title}
      </h1>
      {
        description && (
          <p class="page-lede">
            {description}
          </p>
        )
      }
      {updated && <Byline author={author} updated={updated} reviewed={reviewed} />}
      {
        status && (
          <p class="mt-5 inline-flex items-center gap-2 rounded-full border border-[var(--border)] px-3 py-1 text-xs text-[var(--text-muted)]">
            <span class="h-1.5 w-1.5 rounded-full bg-[var(--accent)]"></span>
            {status}
          </p>
        )
      }
    </header>
    <div
      class="article-links mt-8 leading-relaxed [&_h2]:mt-10 [&_h2]:font-serif [&_h2]:text-2xl [&_h2]:font-semibold [&_h2]:tracking-tight [&_h3]:mt-8 [&_h3]:font-serif [&_h3]:text-xl [&_h3]:font-semibold [&_h3]:tracking-tight [&_li]:mt-1.5 [&_p]:mt-4 [&_ul]:mt-4 [&_ul]:list-disc [&_ul]:pl-5 [&_ol]:mt-4 [&_ol]:list-decimal [&_ol]:pl-5 [&_code]:rounded [&_code]:bg-[var(--bg-elevated)] [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:font-mono [&_code]:text-[0.85em] [&>table]:mt-6 [&>table]:w-full [&>table]:border-collapse [&>table]:text-sm [&>table_th]:border-b [&>table_th]:border-[var(--border)] [&>table_th]:px-3 [&>table_th]:py-2 [&>table_th]:text-left [&>table_th]:align-top [&>table_th]:font-semibold [&>table_td]:border-b [&>table_td]:border-[var(--border)] [&>table_td]:px-3 [&>table_td]:py-2 [&>table_td]:align-top"
    >
      {thread && (
        <p
          class="mc-thread mb-8 border-l-2 border-[var(--accent)] pl-4 font-serif text-lg italic leading-relaxed text-[var(--text-muted)]"
          set:html={thread}
        />
      )}
      <slot />
    </div>
    <NetworkLinks />
  </article>
</BaseLayout>
