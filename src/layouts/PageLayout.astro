---
import BaseLayout from './BaseLayout.astro';
import Byline from '../components/Byline.astro';
import NetworkLinks from '../components/NetworkLinks.astro';

interface Props {
  title: string;
  description?: string;
  kicker?: string;
  status?: string;
  author?: string;
  updated?: string;
  reviewed?: boolean;
  thread?: string;
  about?: Array<{ name: string; type?: string; sameAs?: string[] }>;
}

const { title, description, kicker, status, author, updated, reviewed, thread, about } =
  Astro.props;
---

<BaseLayout
  title={`${title} — melanocortin.com`}
  description={description}
  pageType="article"
  dateModified={updated ?? '2026'}
  about={about}
>
  <article class="mx-auto max-w-3xl px-6 py-16">
    <header class="border-b border-[var(--border)] pb-8">
      {
        kicker && (
          <p class="font-mono text-xs uppercase tracking-[0.2em] text-[var(--accent)]">
            {kicker}
          </p>
        )
      }
      <h1 class="mt-3 font-serif text-4xl leading-tight font-semibold tracking-tight">
        {title}
      </h1>
      {
        description && (
          <p class="page-lede mt-4 text-lg leading-relaxed text-[var(--text-muted)]">
            {description}
          </p>
        )
      }
      {updated && <Byline author={author} updated={updated} reviewed={reviewed} />}
      {
        status && (
          <p class="mt-5 inline-flex items-center gap-2 rounded-full border border-[var(--border)] px-3 py-1 text-xs text-[var(--text-muted)]">
            <span class="h-1.5 w-1.5 rounded-full bg-[var(--accent)]"></span>
            {status}
          </p>
        )
      }
    </header>
    <div
      class="mt-8 leading-relaxed [&_h2]:mt-10 [&_h2]:font-serif [&_h2]:text-2xl [&_h2]:font-semibold [&_h2]:tracking-tight [&_h3]:mt-8 [&_h3]:font-serif [&_h3]:text-xl [&_h3]:font-semibold [&_h3]:tracking-tight [&_li]:mt-1.5 [&_li_a]:text-[var(--accent)] [&_li_a]:underline [&_li_a]:decoration-dotted [&_p]:mt-4 [&_p_a]:text-[var(--accent)] [&_p_a]:underline [&_p_a]:decoration-dotted [&_ul]:mt-4 [&_ul]:list-disc [&_ul]:pl-5 [&_ol]:mt-4 [&_ol]:list-decimal [&_ol]:pl-5 [&_code]:rounded [&_code]:bg-[var(--bg-elevated)] [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:font-mono [&_code]:text-[0.85em] [&_table]:mt-6 [&_table]:w-full [&_table]:border-collapse [&_table]:text-sm [&_th]:border [&_th]:border-[var(--border)] [&_th]:bg-[var(--bg-elevated)] [&_th]:px-3 [&_th]:py-2 [&_th]:text-left [&_th]:align-top [&_th]:font-semibold [&_td]:border [&_td]:border-[var(--border)] [&_td]:px-3 [&_td]:py-2 [&_td]:align-top"
    >
      {thread && (
        <p
          class="mc-thread mb-8 border-l-2 border-[var(--accent)] pl-4 font-serif text-lg italic leading-relaxed text-[var(--text-muted)]"
          set:html={thread}
        />
      )}
      <slot />
    </div>
    <NetworkLinks />
  </article>
</BaseLayout>
