---
// A reusable cited figure wrapper for the knowledge hub. Renders a slotted
// visual (an SVG-only figure component), a caption, and a small source /
// attribution line in the site's voice. Visuals stay self-contained; this
// only standardises the caption + provenance styling beneath them.
interface Props {
  caption: string;
  source?: string;
}
const { caption, source } = Astro.props;
---

<figure class="cited-figure not-prose my-8">
  <div class="fig-body"><slot /></div>
  <figcaption>
    <span class="fig-cap">{caption}</span>
    {source && <span class="fig-source">{source}</span>}
  </figcaption>
</figure>

<style>
  .cited-figure {
    max-width: 46rem;
    margin-inline: auto;
  }
  .fig-body {
    display: block;
  }
  figcaption {
    margin-top: 0.8rem;
    text-align: center;
    max-width: 42rem;
    margin-inline: auto;
  }
  .fig-cap {
    display: block;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--text-muted);
  }
  .fig-source {
    display: block;
    margin-top: 0.45rem;
    font-size: 0.72rem;
    line-height: 1.45;
    color: var(--text-muted);
    opacity: 0.75;
  }
</style>
