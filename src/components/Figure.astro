---
// A reusable cited figure wrapper for the knowledge hub. Renders a slotted
// visual (an SVG-only figure component), a caption, and a small source /
// attribution line in the site's voice. Visuals stay self-contained; this
// only standardises the caption + provenance styling beneath them.
interface Props {
  caption?: string;
  source?: string;
}
const { caption, source } = Astro.props;
---

<figure class="cited-figure not-prose">
  <div class="fig-body"><slot /></div>
  {(caption || source) && (
    <figcaption>
      {caption && <span class="fig-cap">{caption}</span>}
      {source && <span class="fig-source">{source}</span>}
    </figcaption>
  )}
</figure>

<style>
  .cited-figure {
    max-width: 46rem;
    margin: clamp(2rem, 5vw, 3rem) auto;
  }
  :global(.pillar-visual) .cited-figure {
    margin-block: 0;
  }
  .fig-body {
    display: block;
  }
  @media (max-width: 30rem) {
    .fig-body:has(> :global(.schematic)) {
      margin-inline: -0.5rem;
    }
  }
  figcaption {
    margin-top: 0.8rem;
    text-align: center;
    max-width: 42rem;
    margin-inline: auto;
  }
  .fig-cap {
    display: block;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--text-muted);
  }
  .fig-source {
    display: block;
    margin-top: 0.45rem;
    font-size: 0.72rem;
    line-height: 1.45;
    color: var(--text-muted);
  }
</style>
