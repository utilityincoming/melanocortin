---
import Figure from './Figure.astro';

interface Props {
  caption?: boolean;
}

const { caption = true } = Astro.props;
const explanation = 'Leptin promotes satiety by stimulating POMC neurons and inhibiting AgRP neurons. POMC-derived α-MSH activates MC4R, while AgRP opposes its signaling and favors hunger. Disruption of LEPR, POMC, PCSK1, or MC4R can weaken this satiety pathway. Setmelanotide acts directly at MC4R, downstream of LEPR, POMC, and PCSK1.';
---

<Figure caption={caption ? explanation : undefined}>
  <svg class="schematic" viewBox="0 0 400 450" role="img" aria-label="The leptin–melanocortin appetite circuit">
    <desc>{explanation}</desc>

    <rect class="node" x="108" y="15" width="184" height="62" />
    <text x="200" y="40">Adipose tissue</text>
    <text class="detail" x="200" y="64">Releases leptin</text>

    <rect class="brain-region" x="12" y="109" width="376" height="143" rx="6" />
    <path class="flow" d="M200 77 V94 H106 V174 m-5-5 5 5 5-5" />
    <path class="flow muted-flow" d="M200 94 H294 V174 m-5 0 h10" />
    <text x="200" y="136">Arcuate nucleus</text>
    <text class="detail" x="158" y="161">Stimulates</text>
    <text class="detail" x="253" y="161">Inhibits</text>

    <rect class="active-node" x="25" y="182" width="162" height="57" />
    <text x="106" y="205">POMC neurons</text>
    <text class="detail" x="106" y="229">Release α-MSH</text>

    <rect class="node" x="210" y="182" width="168" height="57" />
    <text x="294" y="205">AgRP/NPY neurons</text>
    <text class="detail" x="294" y="229">Release AgRP</text>

    <path class="flow" d="M106 239 V334 H148 m-5-5 5 5-5 5" />
    <path class="flow muted-flow" d="M294 239 V334 H252 m0-5 v10" />
    <text class="detail" x="154" y="277">Activates</text>
    <text class="detail" x="247" y="277">Opposes</text>
    <text class="detail" x="200" y="301">Activation promotes satiety</text>

    <rect class="active-node" x="156" y="314" width="88" height="40" />
    <text x="200" y="340">MC4R</text>

    <path class="flow" d="M200 374 V362 m-5 5 5-5 5 5" />
    <rect class="active-node" x="91" y="374" width="218" height="62" />
    <text x="200" y="399">Setmelanotide</text>
    <text class="detail" x="200" y="423">Directly activates MC4R</text>
  </svg>
</Figure>

<style>
  .brain-region {
    fill: none;
    stroke: var(--border);
  }
</style>
