---
// The selectivity fingerprint for a single ligand: the readout (primary target,
// window, verdict) and the MC1R–MC5R affinity bars. Shared by the /selectivity
// hub (one per ligand) and the per-ligand pages at /selectivity/<id>.
import type { LigandView } from '../data/selectivity';

interface Props {
  l: LigandView;
  /** The hub hides all but the active panel and drives it with JS. */
  hidden?: boolean;
  /** Heading level for the ligand name (h2 on the hub, h1-adjacent elsewhere). */
  as?: 'h2' | 'div';
}
const { l, hidden = false, as = 'h2' } = Astro.props;
const Name = as;
const description = l.rows.map((row) => {
  if (!row.has) return `${row.rid} (${row.tag}): no curated value.`;
  const species = row.species ? ` (${row.species})` : '';
  return `${row.rid} (${row.tag}): ${row.display}${species}, approximately ${row.nm}${row.action === 'antagonist' ? ', antagonist' : ''}.`;
}).join(' ');
---

<article
  class="plate px-3 py-5 sm:p-7"
  data-panel={l.id}
  hidden={hidden}
  data-action={l.action}
>
  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
    <Name class="font-serif text-2xl font-semibold tracking-tight">
      {l.name}
      <span class="ml-1 align-middle text-xs font-normal uppercase tracking-wide text-[var(--text-muted)]">
        {l.kindLabel}
      </span>
    </Name>
    {l.href && (
      <a href={l.href} class="text-sm quiet">
        Full page →
      </a>
    )}
  </div>
  <p class="mt-1 text-sm text-[var(--text-muted)]">{l.role}</p>

  <div class="sv-readout mt-4 flex flex-wrap items-center gap-x-6 gap-y-2">
    <div>
      <span class="sv-k">Primary target</span>
      <span class="sv-v font-mono">{l.primary ?? '—'}</span>
      {l.primaryTag && <span class="sv-sub">{l.primaryTag}</span>}
    </div>
    <div>
      <span class="sv-k">Selectivity window</span>
      {l.window ? (
        <>
          <span class="sv-v font-mono">{l.windowDisplay}</span>
          <span class="sv-sub">over {l.secondRid}</span>
        </>
      ) : (
        <span class="sv-v font-mono">n/a</span>
      )}
    </div>
    <span class={`sv-verdict v-${l.verdict} ${l.action === 'antagonist' ? 'is-anta' : ''}`}>
      {l.verdictLabel}
      {l.action === 'antagonist' ? ' · blocker' : ''}
    </span>
  </div>

  <svg class="schematic affinity-chart" viewBox="0 0 400 260" role="img" aria-label={`${l.name} across MC1R–MC5R`}>
    <desc>{description}</desc>
    {l.rows.map((row, index) => (
      <g transform={`translate(0 ${12 + index * 49})`}>
        <text class:list={['receptor', { primary: row.primary }]} x="10" y="19">{row.rid}</text>
        <text class="detail site" x="69" y="19">{row.tag}</text>
        {row.has ? (
          <>
            <text class="detail reading" x="390" y="19">
              {row.display}{row.species === 'mouse' ? 'ᵐ' : row.species === 'rat' ? 'ʳ' : ''} · ≈{row.nm}
            </text>
            <rect class="track" x="10" y="27" width="380" height="8" rx="4" />
            <rect
              class:list={['bar', { primary: row.primary, antagonist: row.action === 'antagonist' }]}
              x="10"
              y="27"
              width={380 * row.width / 100}
              height="8"
              rx="4"
            />
          </>
        ) : (
          <text class="detail reading" x="390" y="19">No curated value</text>
        )}
      </g>
    ))}
  </svg>
  {l.rows.some((row) => row.has && row.action === 'antagonist') && (
    <p class="chart-key">Outlined bars show antagonists.</p>
  )}
</article>

<style>
  .sv-readout { font-size: 0.85rem; }
  .sv-k { display: block; font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-muted); }
  .sv-v { font-size: 1.05rem; font-weight: 700; }
  .sv-sub { margin-left: 0.4rem; font-size: 0.72rem; color: var(--text-muted); }
  .sv-verdict {
    align-self: center;
    padding: 0.2rem 0.6rem;
    border-radius: 9999px;
    font-size: 0.72rem;
    font-weight: 600;
    background: var(--accent-soft);
    color: var(--accent-strong);
  }
  .sv-verdict.v-broad { background: var(--bg); color: var(--text-muted); }
  .sv-verdict.is-anta { background: var(--bg); color: var(--text); }

  .affinity-chart {
    margin-top: 1.25rem;
    border: 0;
    max-width: none;
  }
  .affinity-chart .receptor, .affinity-chart .site { text-anchor: start; }
  .affinity-chart .reading { text-anchor: end; }
  .affinity-chart .receptor.primary { fill: var(--accent-strong); }
  .track { fill: var(--bg); stroke: var(--border); }
  .bar { fill: var(--accent-soft); stroke: var(--accent); }
  .bar.primary { fill: var(--accent); stroke: var(--accent-strong); }
  .bar.antagonist { fill: none; stroke: var(--text-muted); stroke-width: 1.75; }
  .bar.antagonist.primary { stroke: var(--accent-strong); }
  .chart-key { margin-top: 0.5rem; color: var(--text-muted); font-size: 0.8rem; }
</style>
