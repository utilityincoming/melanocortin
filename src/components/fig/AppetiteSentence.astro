---
// The setmelanotide mechanism — the leptin→POMC→α-MSH "supply line" to MC4R is
// broken in POMC/PCSK1/LEPR deficiency (or severed by hypothalamic injury), so
// the receptor never hears "enough" and hunger is relentless. Setmelanotide is a
// synthetic α-MSH that plugs in at MC4R itself, downstream of the break.
// Self-contained animated SVG; theme-aware; reduced-motion still frame.
interface Props {
  caption?: boolean;
}
const { caption = true } = Astro.props;
---

<figure class="appetite-sentence not-prose my-8">
  <svg viewBox="0 0 820 300" role="img" aria-labelledby="as-t as-d" xmlns="http://www.w3.org/2000/svg">
    <title id="as-t">How setmelanotide repairs the appetite circuit</title>
    <desc id="as-d"
      >The leptin-to-α-MSH supply line that tells MC4R the body is full is broken in
      POMC, PCSK1 or leptin-receptor deficiency, so no signal reaches the receptor and
      hunger is relentless. Setmelanotide is a synthetic α-MSH that binds MC4R directly,
      downstream of the break, restoring the sensation of enough.</desc
    >

    <!-- broken supply line -->
    <rect class="supply" x="36" y="84" width="290" height="60" rx="10" />
    <text x="181" y="107" text-anchor="middle" class="supply-t">α-MSH supply line</text>
    <text x="181" y="129" text-anchor="middle" class="supply-s">leptin ▸ POMC ▸ α-MSH</text>
    <g class="break">
      <line x1="232" y1="98" x2="250" y2="130" /><line x1="250" y1="98" x2="232" y2="130" />
    </g>
    <text x="181" y="164" text-anchor="middle" class="cause">broken in POMC · PCSK1 · LEPR deficiency</text>
    <text x="181" y="178" text-anchor="middle" class="cause">(or cut off by hypothalamic injury)</text>

    <!-- no signal reaches the receptor -->
    <line class="nosignal" x1="330" y1="114" x2="470" y2="114" marker-end="url(#as-x)" />
    <text x="398" y="103" text-anchor="middle" class="nolbl">no α-MSH</text>

    <!-- MC4R -->
    <circle class="mc-glow" cx="500" cy="114" r="22" />
    <rect class="receptor" x="486" y="94" width="28" height="40" rx="9" />
    <text x="500" y="80" text-anchor="middle" class="mc-lbl">MC4R</text>

    <!-- setmelanotide plugs in -->
    <g class="sm">
      <line x1="500" y1="236" x2="500" y2="140" marker-end="url(#as-a)" />
      <rect x="438" y="238" width="124" height="28" rx="14" class="sm-tok" />
      <text x="500" y="256" text-anchor="middle" class="sm-t">setmelanotide</text>
      <text x="500" y="284" text-anchor="middle" class="sm-s">a synthetic α-MSH — binds MC4R directly</text>
    </g>

    <!-- output -->
    <line class="wire" x1="528" y1="114" x2="604" y2="114" marker-end="url(#as-a)" />
    <text x="690" y="118" text-anchor="middle" class="out-hunger">still hungry</text>
    <g class="out-enough">
      <text x="690" y="110" text-anchor="middle" class="enough-t">“enough”</text>
      <text x="690" y="126" text-anchor="middle" class="enough-s">satiety · energy use</text>
    </g>

    <defs>
      <marker id="as-a" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto">
        <path d="M0 0 L6 3 L0 6 Z" class="arrowhead" />
      </marker>
      <marker id="as-x" markerWidth="9" markerHeight="9" refX="7" refY="3" orient="auto">
        <path d="M0 0 L6 3 L0 6 Z" class="arrowhead-dim" />
      </marker>
    </defs>
  </svg>

  {
    caption && (
      <figcaption>
        The α-MSH <strong>supply line</strong> is broken in these diseases, so leptin's
        “I'm full” message never reaches <strong>MC4R</strong> and hunger is relentless.
        Setmelanotide is a synthetic α-MSH that plugs in at the receptor itself — downstream
        of the break — restoring the missing signal.
        <span class="fig-src">Mechanism: StatPearls NBK589641; the leptin–melanocortin pathway.</span>
      </figcaption>
    )
  }
</figure>

<style>
  .appetite-sentence {
    --hunger: #c0392b;
    --on-accent: #fff;
    max-width: 46rem;
    margin-inline: auto;
  }
  @media (prefers-color-scheme: dark) {
    .appetite-sentence {
      --hunger: #e05a4a;
      --on-accent: #2b261d;
    }
  }
  .appetite-sentence svg {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    background: var(--bg-elevated);
    padding: 0.6rem 0.5rem;
  }

  .supply { fill: var(--accent-soft); stroke: var(--hunger); stroke-width: 1.5; stroke-dasharray: 5 3; opacity: 0.8; }
  .supply-t { font-size: 13px; font-weight: 600; fill: var(--text); }
  .supply-s { font-size: 11px; fill: var(--text-muted); }
  .break line { stroke: var(--hunger); stroke-width: 3; stroke-linecap: round; }
  .cause { font-size: 10.5px; fill: var(--text-muted); }
  .nosignal { stroke: var(--hunger); stroke-width: 1.6; stroke-dasharray: 3 4; opacity: 0.7; }
  .nolbl { font-size: 10px; fill: var(--hunger); }
  .arrowhead-dim { fill: var(--hunger); opacity: 0.7; }

  .receptor { fill: var(--accent); }
  .mc-lbl { font-size: 12px; font-weight: 600; fill: var(--accent-strong); }
  .mc-glow { fill: var(--accent); opacity: 0; }

  .sm line { stroke: var(--accent); stroke-width: 2; fill: none; }
  .sm-tok { fill: var(--accent); stroke: var(--accent-strong); stroke-width: 1; }
  .sm-t { font-size: 12px; font-weight: 600; fill: var(--on-accent); }
  .sm-s { font-size: 10.5px; fill: var(--text-muted); }
  .arrowhead { fill: var(--accent); }
  .wire { stroke: var(--border); stroke-width: 2; fill: none; }

  .out-hunger { font-size: 13px; font-weight: 600; fill: var(--hunger); }
  .enough-t { font-size: 14px; font-weight: 700; fill: var(--accent-strong); }
  .enough-s { font-size: 10px; fill: var(--text-muted); }

  /* ---- one 9s loop: without the drug (hunger) → setmelanotide → enough ---- */
  .sm { animation: as-sm 9s ease-in-out infinite; }
  .mc-glow { animation: as-glow 9s ease-in-out infinite; }
  .out-hunger { animation: as-hunger 9s ease-in-out infinite; }
  .out-enough { animation: as-enough 9s ease-in-out infinite; }

  @keyframes as-sm { 0%,44%{opacity:0} 56%,92%{opacity:1} 100%{opacity:0} }
  @keyframes as-glow { 0%,46%{opacity:0} 58%,90%{opacity:.8} 100%{opacity:0} }
  @keyframes as-hunger { 0%,44%{opacity:1} 54%,95%{opacity:0} 100%{opacity:1} }
  @keyframes as-enough { 0%,46%{opacity:0} 56%,92%{opacity:1} 100%{opacity:0} }

  @media (prefers-reduced-motion: reduce) {
    .sm, .mc-glow, .out-hunger, .out-enough { animation: none; }
    .sm { opacity: 1; }
    .mc-glow { opacity: 0.8; }
    .out-hunger { opacity: 0; }
    .out-enough { opacity: 1; }
  }

  figcaption {
    margin-top: 0.75rem;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--text-muted);
    text-align: center;
    max-width: 42rem;
    margin-inline: auto;
  }
  figcaption strong { color: var(--text); font-weight: 600; }
  .fig-src { display: block; margin-top: 0.4rem; font-size: 0.72rem; opacity: 0.8; }
</style>
