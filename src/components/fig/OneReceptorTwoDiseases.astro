---
// dersimelagon-two-diseases — one oral MC1R agonist, two unrelated diseases:
// building protective pigment in erythropoietic protoporphyria, and calming
// inflammation/fibrosis in diffuse cutaneous systemic sclerosis. SVG-only.
---

<svg class="two-fig" viewBox="0 0 860 352" role="img" aria-labelledby="two-t two-d" xmlns="http://www.w3.org/2000/svg">
  <title id="two-t">One receptor, two diseases</title>
  <desc id="two-d"
    >Dersimelagon activates MC1R. In erythropoietic protoporphyria that builds
    protective eumelanin for photoprotection (Phase 3 INSPIRE met its endpoint).
    On immune, endothelial and fibroblast cells the same receptor calms
    inflammation and fibrosis in diffuse cutaneous systemic sclerosis (Phase 2).</desc
  >

  <!-- dersimelagon pill -->
  <rect class="pill" x="44" y="158" width="46" height="18" rx="9" />
  <line class="pill-score" x1="67" y1="159" x2="67" y2="175" />
  <text x="67" y="194" text-anchor="middle" class="card-t">dersimelagon</text>
  <text x="67" y="209" text-anchor="middle" class="sub">once-daily MC1R pill</text>

  <!-- to MC1R -->
  <path class="wire" d="M96 167 H206" marker-end="url(#two-ah)" />
  <circle class="mc1r-glow" cx="232" cy="167" r="22" />
  <rect class="receptor" x="218" y="147" width="28" height="40" rx="9" />
  <text x="232" y="133" text-anchor="middle" class="cap-a">MC1R</text>
  <text x="232" y="206" text-anchor="middle" class="cap">one receptor</text>

  <!-- branches -->
  <path class="branch" d="M256 158 Q345 130 430 121" marker-end="url(#two-ah)" />
  <path class="branch" d="M256 178 Q345 220 430 269" marker-end="url(#two-ah)" />

  <!-- Card A: EPP -->
  <rect class="card" x="430" y="62" width="406" height="118" rx="10" />
  <text x="450" y="90" class="card-t">Erythropoietic protoporphyria</text>
  <rect class="badge" x="708" y="72" width="120" height="20" rx="10" />
  <text x="768" y="86" text-anchor="middle" class="badge-t">Phase 3 · 2026</text>
  <circle class="dot" cx="452" cy="115" r="4" />
  <text x="466" y="119" class="line">build protective eumelanin</text>
  <circle class="dot" cx="452" cy="137" r="4" />
  <text x="466" y="141" class="line">more pain-free time in sunlight</text>
  <text x="450" y="166" class="status">INSPIRE Phase 3 · n=165 · met endpoint</text>

  <!-- Card B: dcSSc -->
  <rect class="card" x="430" y="210" width="406" height="118" rx="10" />
  <text x="450" y="238" class="card-t">Diffuse cutaneous systemic sclerosis</text>
  <rect class="badge badge-open" x="748" y="220" width="80" height="20" rx="10" />
  <text x="788" y="234" text-anchor="middle" class="badge-t">Phase 2</text>
  <circle class="dot" cx="452" cy="263" r="4" />
  <text x="466" y="267" class="line">MC1R on immune, vessel &amp; fibroblast cells</text>
  <circle class="dot" cx="452" cy="285" r="4" />
  <text x="466" y="289" class="line">calms inflammation, vessels &amp; fibrosis</text>
  <text x="450" y="314" class="status">proof-of-concept · dcSSc · n=73</text>

  <defs>
    <marker id="two-ah" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto">
      <path d="M0 0 L6 3 L0 6 Z" class="arrowhead" />
    </marker>
  </defs>
</svg>

<style>
  .two-fig {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    background: var(--bg-elevated);
    padding: 0.6rem 0.5rem;
  }
  .pill { fill: var(--accent); stroke: var(--accent-strong); stroke-width: 1; }
  .pill-score { stroke: #fdf5ea; stroke-width: 1; opacity: 0.7; }
  .card-t { font-size: 12.5px; font-weight: 600; fill: var(--accent-strong); }
  .sub { font-size: 10px; fill: var(--text-muted); }
  .wire { stroke: var(--border); stroke-width: 2; fill: none; }
  .arrowhead { fill: var(--text-muted); }
  .mc1r-glow { fill: var(--accent); opacity: 0; animation: two-glow 4.5s ease-in-out infinite; }
  .receptor { fill: var(--accent); }
  .cap-a { font-size: 12px; font-weight: 600; fill: var(--accent-strong); }
  .cap { font-size: 11px; fill: var(--text-muted); }
  .branch { fill: none; stroke: var(--accent); stroke-width: 1.8; opacity: 0.55; }
  .card { fill: none; stroke: var(--border); stroke-width: 1; }
  .badge { fill: var(--accent-soft); stroke: var(--accent); stroke-width: 1; }
  .badge-open { fill: none; stroke: var(--accent); stroke-width: 1; stroke-dasharray: 3 3; }
  .badge-t { font-size: 9.5px; font-weight: 600; fill: var(--accent-strong); }
  .dot { fill: var(--accent); }
  .line { font-size: 11.5px; fill: var(--text); }
  .status { font-size: 11px; font-weight: 600; fill: var(--accent-strong); }

  @keyframes two-glow {
    0%, 100% { opacity: 0; }
    50% { opacity: 0.8; }
  }
  @media (prefers-reduced-motion: reduce) {
    .mc1r-glow { animation: none; opacity: 0.5; }
  }
</style>
