---
const core = ['His', 'Phe', 'Arg', 'Trp'];
const receptors = [
  ['MC1R', 'Pigmentation'],
  ['MC3R', 'Energy partitioning'],
  ['MC4R', 'Appetite regulation'],
  ['MC5R', 'Exocrine secretion'],
];
---

<svg class="schematic" viewBox="0 0 400 345" role="img" aria-label="One key, many locks: receptor selectivity of α-MSH">
  <desc>The shared core is histidine, phenylalanine, arginine and tryptophan. α-MSH can activate MC1R, MC3R, MC4R and MC5R. MC2R instead requires ACTH and the accessory protein MRAP1.</desc>
  <rect class="active-node" x="16" y="20" width="107" height="45" rx="6" />
  <text x="69.5" y="49">α-MSH</text>
  <text class="detail" x="69.5" y="90">Shared core</text>
  {core.map((residue, index) => (
    <g transform={`translate(0 ${104 + index * 35})`}>
      <rect class="active-node" x="31" y="0" width="77" height="29" />
      <text x="69.5" y="21">{residue}</text>
    </g>
  ))}
  <path class="flow" d="M123 42 H145 V228" />
  {receptors.map(([name, functionLabel], i) => (
    <g transform={`translate(0 ${42 + 62 * i})`}>
      <path class="flow" d="M145 0 H168 m-5-5 5 5-5 5" />
      <rect class={i === 0 ? 'active-node' : 'node'} x="175" y="-25" width="209" height="53" rx="6" />
      <text x="279.5" y="-4">{name}</text>
      <text class="detail" x="279.5" y="20">{functionLabel}</text>
    </g>
  ))}
  <path class="flow blocked-flow" d="M145 228 V294 H163" />
  <path class="flow muted-flow" d="M164 289 V299" />
  <rect class="node" x="175" y="264" width="209" height="62" rx="6" />
  <text x="279.5" y="290">MC2R</text>
  <text class="detail" x="279.5" y="314">ACTH + MRAP1 required</text>
</svg>
