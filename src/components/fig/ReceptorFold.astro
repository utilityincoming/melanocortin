---
// receptor-fold — the shared architecture of a melanocortin receptor:
// seven transmembrane helices threaded through the cell membrane, a shallow
// orthosteric pocket facing the outside (where the ligand binds), and the
// intracellular face where the Gs protein couples. TM6 is highlighted because
// it is the helix that swings outward on activation (see the activation figure).
// Schematic topology cartoon, not a real atomic structure. SVG-only; wrap in <Figure>.
---

<svg class="fold-fig" viewBox="0 0 720 476" role="img" aria-labelledby="fold-t fold-d" xmlns="http://www.w3.org/2000/svg">
  <title id="fold-t">The seven-helix fold of a melanocortin receptor</title>
  <desc id="fold-d"
    >A melanocortin receptor is a class-A GPCR: seven transmembrane helices
    cross the cell membrane as a bundle. A shallow orthosteric pocket sits in
    the extracellular half of the bundle, where the ligand binds; on the
    intracellular face a G protein couples and cyclic AMP carries the signal
    inward. Transmembrane helix 6 is highlighted as the helix that moves on
    activation.</desc
  >

  <!-- zone labels -->
  <text x="60" y="40" class="zone">OUTSIDE THE CELL</text>
  <text x="60" y="454" class="zone">INSIDE THE CELL</text>

  <!-- membrane band -->
  <rect class="membrane" x="40" y="176" width="640" height="128" />
  <line class="mem-edge" x1="40" y1="176" x2="680" y2="176" />
  <line class="mem-edge" x1="40" y1="304" x2="680" y2="304" />
  <text x="52" y="197" class="mem-l">lipid membrane</text>

  <!-- serpentine loops (drawn under the helices) -->
  <g class="loops">
    <!-- extracellular loops (top) -->
    <path d="M215 135 Q247 104 280 135" />
    <path d="M345 135 Q377 104 410 135" />
    <path d="M475 135 Q507 104 540 135" />
    <!-- intracellular loops (bottom) -->
    <path d="M150 345 Q182 376 215 345" />
    <path d="M280 345 Q312 376 345 345" />
    <path d="M410 345 Q442 376 475 345" />
    <!-- N- and C-terminal tails -->
    <path d="M150 135 Q128 118 112 122" />
    <path d="M540 345 Q560 362 576 360" />
  </g>
  <text x="104" y="114" text-anchor="end" class="term">N</text>
  <text x="584" y="364" class="term">C</text>

  <!-- the orthosteric pocket (extracellular half) -->
  <ellipse class="pocket" cx="345" cy="212" rx="96" ry="30" />

  <!-- seven helices -->
  <g class="helices">
    <rect x="135" y="135" width="30" height="210" rx="15" /><text x="150" y="163" class="hn">1</text>
    <rect x="200" y="135" width="30" height="210" rx="15" /><text x="215" y="163" class="hn">2</text>
    <rect x="265" y="135" width="30" height="210" rx="15" /><text x="280" y="163" class="hn">3</text>
    <rect x="330" y="135" width="30" height="210" rx="15" /><text x="345" y="163" class="hn">4</text>
    <rect x="395" y="135" width="30" height="210" rx="15" /><text x="410" y="163" class="hn">5</text>
    <rect class="tm6" x="460" y="135" width="30" height="210" rx="15" /><text x="475" y="163" class="hn hn6">6</text>
    <rect x="525" y="135" width="30" height="210" rx="15" /><text x="540" y="163" class="hn">7</text>
  </g>

  <!-- G protein docking shape (intracellular half) -->
  <ellipse class="gprot" cx="345" cy="374" rx="72" ry="26" />
  <text x="345" y="379" text-anchor="middle" class="gp-l">G protein</text>

  <!-- pocket label + leader -->
  <line class="leader" x1="441" y1="205" x2="560" y2="150" />
  <text x="566" y="147" class="lead-t">the orthosteric pocket</text>
  <text x="566" y="164" class="lead-s">where the ligand binds</text>

  <!-- TM6 note -->
  <line class="leader" x1="490" y1="240" x2="606" y2="262" />
  <text x="612" y="259" class="lead-t">TM6</text>
  <text x="612" y="276" class="lead-s">swings out to</text>
  <text x="612" y="291" class="lead-s">switch the receptor on</text>

  <!-- G protein label + leader -->
  <line class="leader" x1="417" y1="374" x2="560" y2="392" />
  <text x="566" y="389" class="lead-t">couples here → cAMP</text>
  <text x="566" y="406" class="lead-s">the signal carried inward</text>

  <text x="345" y="446" text-anchor="middle" class="foot">one fold, five receptors — MC1R through MC5R share this architecture</text>
</svg>

<style>
  .fold-fig {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    background: var(--bg-elevated);
    padding: 0.6rem 0.5rem;
  }
  .zone { font-size: 11px; font-weight: 600; letter-spacing: 0.06em; fill: var(--text-muted); }
  .membrane { fill: var(--accent-soft); opacity: 0.4; }
  .mem-edge { stroke: var(--border); stroke-width: 1; stroke-dasharray: 2 3; }
  .mem-l { font-size: 10px; fill: var(--text-muted); opacity: 0.8; }

  .loops path { fill: none; stroke: var(--text-muted); stroke-width: 2; opacity: 0.55; }
  .term { font-size: 11px; font-weight: 700; fill: var(--text-muted); }

  .pocket { fill: var(--accent); opacity: 0.12; stroke: var(--accent); stroke-width: 1.2; stroke-dasharray: 4 4; }

  .helices rect { fill: var(--accent); opacity: 0.85; stroke: var(--accent-strong); stroke-width: 1; }
  .helices .tm6 { fill: var(--accent-strong); opacity: 1; }
  .hn { font-size: 12px; font-weight: 700; fill: var(--bg-elevated); text-anchor: middle; }
  .hn6 { fill: var(--bg-elevated); }

  .gprot { fill: none; stroke: var(--text-muted); stroke-width: 1.4; stroke-dasharray: 5 4; }
  .gp-l { font-size: 11px; font-weight: 600; fill: var(--text-muted); }

  .leader { stroke: var(--text-muted); stroke-width: 1; opacity: 0.7; }
  .lead-t { font-size: 12px; font-weight: 600; fill: var(--text); }
  .lead-s { font-size: 10.5px; fill: var(--text-muted); }
  .foot { font-size: 10.5px; font-style: italic; fill: var(--text-muted); }
</style>
