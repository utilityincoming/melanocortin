    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    background: var(--bg-elevated);
    padding: 0.6rem 0.5rem;
  }
  .col { fill: none; stroke: var(--border); stroke-width: 1; }
  .col.accent { fill: var(--accent-soft); stroke: var(--accent); }
  .col-h { font-size: 13px; font-weight: 700; fill: var(--text); }
  .col-h.accent-t { fill: var(--accent-strong); }
  .col-sub { font-size: 10.5px; font-family: ui-monospace, monospace; fill: var(--text-muted); }
  .node { fill: var(--bg); stroke: var(--border); stroke-width: 1; }
  .node.accent { stroke: var(--accent); stroke-width: 1.5; }
  .node-t { font-size: 12.5px; font-weight: 600; fill: var(--text); }
  .node-t.accent-t { fill: var(--accent-strong); }
  .node-s { font-size: 10.5px; fill: var(--text-muted); }
  .flow { fill: none; stroke: var(--text-muted); stroke-width: 1.6; }
  .flow.accent-flow { stroke: var(--accent); }
  .bridge { fill: none; stroke: var(--text-muted); stroke-width: 1.6; }
  .bridge-t { font-size: 10px; font-style: italic; fill: var(--text-muted); }
</style>
