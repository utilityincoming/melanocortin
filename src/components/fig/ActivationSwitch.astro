---
// activation-switch — how a melanocortin receptor flips on. Left: inactive, no
// agonist, TM6 packed against the bundle, the intracellular cavity closed, no
// signal. Right: agonist bound in the pocket, TM6's cytoplasmic end swings
// outward, opening the cavity so the Gs protein couples and cyclic AMP is made
// (Israeli 2021). An antagonist binds the same pocket but jams the TM6 hinge.
// Schematic; the two states are shown side by side. SVG-only; wrap in <Figure>.
---

<svg class="act-fig" viewBox="0 0 720 452" role="img" aria-labelledby="act-t act-d" xmlns="http://www.w3.org/2000/svg">
  <title id="act-t">How agonist binding flips the receptor on</title>
  <desc id="act-d"
    >Two states of a melanocortin receptor. On the left, with no agonist bound,
    transmembrane helix 6 is packed against the bundle and the intracellular
    cavity is closed, so no signal passes. On the right, an agonist sits in the
    pocket, TM6 swings outward, the cavity opens, and the Gs protein couples to
    make cyclic AMP.</desc
  >

  <!-- panel frames -->
  <rect class="frame" x="24" y="66" width="320" height="322" rx="12" />
  <rect class="frame" x="376" y="66" width="320" height="322" rx="12" />

  <!-- ============ LEFT: inactive ============ -->
  <text x="184" y="92" text-anchor="middle" class="state">INACTIVE</text>
  <text x="184" y="110" text-anchor="middle" class="state-s">no agonist bound</text>
  <rect class="membrane" x="44" y="172" width="280" height="92" />
  <line class="mem-edge" x1="44" y1="172" x2="324" y2="172" />
  <line class="mem-edge" x1="44" y1="264" x2="324" y2="264" />
  <ellipse class="pocket" cx="150" cy="196" rx="70" ry="20" />
  <g class="helix">
    <rect x="83" y="128" width="26" height="180" rx="13" />
    <rect x="119" y="128" width="26" height="180" rx="13" />
    <rect x="155" y="128" width="26" height="180" rx="13" />
    <rect class="tm6" x="201" y="128" width="26" height="180" rx="13" />
  </g>
  <text x="214" y="322" text-anchor="middle" class="tm6-l">TM6</text>
  <text x="150" y="352" text-anchor="middle" class="off">✕ cavity closed — no cAMP</text>

  <!-- ============ transition arrow ============ -->
  <text x="360" y="158" text-anchor="middle" class="arrow-l">agonist</text>
  <text x="360" y="173" text-anchor="middle" class="arrow-l">binds</text>
  <path class="arrow" d="M330 210 H388" marker-end="url(#act-ah)" />

  <!-- ============ RIGHT: active ============ -->
  <text x="536" y="92" text-anchor="middle" class="state on">ACTIVE</text>
  <text x="536" y="110" text-anchor="middle" class="state-s">agonist bound</text>
  <rect class="membrane" x="396" y="172" width="280" height="92" />
  <line class="mem-edge" x1="396" y1="172" x2="676" y2="172" />
  <line class="mem-edge" x1="396" y1="264" x2="676" y2="264" />
  <ellipse class="pocket on" cx="502" cy="196" rx="70" ry="20" />
  <!-- agonist in the pocket -->
  <g class="agonist">
    <circle cx="486" cy="190" r="6" /><circle cx="500" cy="185" r="6" />
    <circle cx="514" cy="190" r="6" /><circle cx="500" cy="200" r="6" />
  </g>
  <g class="helix">
    <rect x="435" y="128" width="26" height="180" rx="13" />
    <rect x="471" y="128" width="26" height="180" rx="13" />
    <rect x="507" y="128" width="26" height="180" rx="13" />
    <!-- TM6 swung outward at its cytoplasmic end -->
    <g transform="rotate(22 566 140)">
      <rect class="tm6" x="553" y="128" width="26" height="180" rx="13" />
    </g>
  </g>
  <text x="612" y="330" text-anchor="middle" class="tm6-l on">TM6 swings out</text>
  <!-- opened cavity + G protein -->
  <ellipse class="gprot" cx="540" cy="336" rx="50" ry="22" />
  <text x="540" y="341" text-anchor="middle" class="gp-l">Gs</text>
  <g class="camp">
    <circle cx="524" cy="360" r="4" /><circle cx="540" cy="360" r="4" /><circle cx="556" cy="360" r="4" />
  </g>
  <text x="540" y="384" text-anchor="middle" class="on-l">→ cAMP</text>

  <!-- antagonist note -->
  <text x="360" y="424" text-anchor="middle" class="foot">An antagonist like SHU9119 binds the same pocket — but its bulky side chain jams the TM6 hinge, so the switch can't move.</text>

  <defs>
    <marker id="act-ah" markerWidth="9" markerHeight="9" refX="6" refY="3" orient="auto">
      <path d="M0 0 L6 3 L0 6 Z" class="arrowhead" />
    </marker>
  </defs>
</svg>

<style>
  .act-fig {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    background: var(--bg-elevated);
    padding: 0.6rem 0.5rem;
  }
  .frame { fill: none; stroke: var(--border); stroke-width: 1; opacity: 0.7; }
  .state { font-size: 12.5px; font-weight: 700; letter-spacing: 0.05em; fill: var(--text-muted); }
  .state.on { fill: var(--accent-strong); }
  .state-s { font-size: 10.5px; fill: var(--text-muted); }

  .membrane { fill: var(--accent-soft); opacity: 0.4; }
  .mem-edge { stroke: var(--border); stroke-width: 1; stroke-dasharray: 2 3; }
  .pocket { fill: var(--accent); opacity: 0.1; stroke: var(--accent); stroke-width: 1; stroke-dasharray: 4 4; }
  .pocket.on { opacity: 0.2; stroke-dasharray: none; }

  .helix rect { fill: var(--accent); opacity: 0.8; stroke: var(--accent-strong); stroke-width: 1; }
  .helix .tm6 { fill: var(--accent-strong); opacity: 1; }
  .tm6-l { font-size: 10.5px; font-weight: 600; fill: var(--text-muted); }
  .tm6-l.on { fill: var(--accent-strong); }

  .agonist circle { fill: var(--accent-strong); }
  .arrow { stroke: var(--text-muted); stroke-width: 2; fill: none; }
  .arrowhead { fill: var(--text-muted); }
  .arrow-l { font-size: 11px; font-weight: 600; fill: var(--text); }

  .off { font-size: 10.5px; fill: var(--text-muted); }
  .gprot { fill: var(--accent-soft); stroke: var(--accent-strong); stroke-width: 1.2; }
  .gp-l { font-size: 11px; font-weight: 700; fill: var(--accent-strong); }
  .on-l { font-size: 11px; font-weight: 700; fill: var(--accent-strong); }
  .camp circle { fill: var(--accent-strong); opacity: 0; animation: act-rise 5s linear infinite; }
  .camp circle:nth-child(1) { animation-delay: 0s; }
  .camp circle:nth-child(2) { animation-delay: 0.7s; }
  .camp circle:nth-child(3) { animation-delay: 1.4s; }
  .foot { font-size: 10.5px; font-style: italic; fill: var(--text-muted); }

  @keyframes act-rise {
    0% { transform: translateY(0); opacity: 0; }
    15% { opacity: 1; }
    70% { transform: translateY(-30px); opacity: 1; }
    85%, 100% { transform: translateY(-30px); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .camp circle { animation: none; opacity: 0.9; }
  }
</style>
