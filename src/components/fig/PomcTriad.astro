---
const branches = [
  { name: 'Reduced ACTH → MC2R signaling', effect: 'Adrenal insufficiency' },
  { name: 'Reduced α-MSH → MC1R signaling', effect: 'Red hair and lighter skin' },
  { name: 'Reduced α-MSH → MC4R signaling', effect: 'Severe early-onset obesity and hunger' },
];
---

<svg class="schematic" viewBox="0 0 400 297" role="img" aria-label="Three effects of POMC deficiency">
  <desc>Reduced ACTH signaling at MC2R causes adrenal insufficiency. Reduced α-MSH signaling at MC1R affects pigmentation, and at MC4R it contributes to severe early-onset obesity and hunger. Setmelanotide targets the MC4R pathway.</desc>
  <rect class="node" x="20" y="16" width="194" height="38" rx="6" />
  <text x="117" y="42">POMC deficiency</text>
  <path class="flow muted-flow" d="M42 54 V232" />
  {branches.map(({ name, effect }, i) => (
    <g transform={`translate(0 ${94 + i * 69})`}>
      <path class="flow muted-flow" d="M42 0 H65 m-5-5 5 5-5 5" />
      <rect class={i === 2 ? 'active-node' : 'node'} x="73" y="-22" width="307" height="58" rx="6" />
      <text x="226.5" y="0">{name}</text>
      <text class="detail" x="226.5" y="25">{effect}</text>
    </g>
  ))}
  <text class="detail" x="226.5" y="285">Setmelanotide targets MC4R</text>
</svg>
