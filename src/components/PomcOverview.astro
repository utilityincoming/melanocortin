---
import Figure from './Figure.astro';
---

<Figure source="Harno et al. · Physiological Reviews (2018)" caption="Two routes through the POMC cascade. PC1/3 releases ACTH and β-lipotropin. Where PC2 is present, further processing yields α-MSH and β-endorphin, among other products.">
  <svg class="schematic" viewBox="0 0 400 284" role="img" aria-label="Two routes through the POMC cleavage cascade">
    <desc>
      PC1/3 cleaves POMC to produce ACTH and beta-lipotropin. PC2-dependent processing
      of ACTH yields alpha-MSH. PC2 cleaves beta-lipotropin to release beta-endorphin.
    </desc>
    <g text-anchor="middle">
      <rect class="node" x="130" y="16" width="140" height="44" rx="8" />
      <text x="200" y="44">POMC</text>

      <path class="flow" d="M200 60 V89 H102 V112 M200 89 H298 V112 m-5-5 5 5 5-5 M97 107 l5 5 5-5" />
      <text class="detail" x="248" y="82">PC1/3</text>

      <rect class="node" x="24" y="120" width="156" height="44" rx="8" />
      <rect class="node" x="220" y="120" width="156" height="44" rx="8" />
      <text x="102" y="148">ACTH</text>
      <text x="298" y="148">β-lipotropin</text>

      <path class="flow" d="M102 164 V216 m-5-5 5 5 5-5 M298 164 V216 m-5-5 5 5 5-5" />
      <text class="detail" x="137" y="198">PC2</text>
      <text class="detail" x="333" y="198">PC2</text>

      <rect class="active-node" x="24" y="224" width="156" height="44" rx="8" />
      <rect class="active-node" x="220" y="224" width="156" height="44" rx="8" />
      <text x="102" y="252">α-MSH</text>
      <text x="298" y="252">β-endorphin</text>
    </g>
  </svg>
</Figure>
