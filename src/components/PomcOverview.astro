---
import Figure from './Figure.astro';
---

<Figure caption="Two routes through the POMC cascade. PC1/3 releases ACTH and β-lipotropin. Where PC2 is present, further processing yields α-MSH and β-endorphin, among other products.">
  <svg viewBox="0 0 400 284" role="img" aria-label="Two routes through the POMC cleavage cascade">
    <desc>
      PC1/3 cleaves POMC to produce ACTH and beta-lipotropin. PC2-dependent processing
      of ACTH yields alpha-MSH. PC2 cleaves beta-lipotropin to release beta-endorphin.
    </desc>
    <g text-anchor="middle">
      <rect x="130" y="16" width="140" height="44" rx="8" />
      <text x="200" y="44">POMC</text>

      <path d="M200 60 V89 H102 V112 M200 89 H298 V112 m-4-5 4 5 4-5 M98 107 l4 5 4-5" />
      <text class="enzyme" x="244" y="81">PC1/3</text>

      <rect x="24" y="120" width="156" height="44" rx="8" />
      <rect x="220" y="120" width="156" height="44" rx="8" />
      <text x="102" y="148">ACTH</text>
      <text x="298" y="148">β-lipotropin</text>

      <path d="M102 164 V216 m-4-5 4 5 4-5 M298 164 V216 m-4-5 4 5 4-5" />
      <text class="enzyme" x="132" y="195">PC2</text>
      <text class="enzyme" x="328" y="195">PC2</text>

      <rect class="product" x="24" y="224" width="156" height="44" rx="8" />
      <rect class="product" x="220" y="224" width="156" height="44" rx="8" />
      <text x="102" y="252">α-MSH</text>
      <text x="298" y="252">β-endorphin</text>
    </g>
  </svg>
</Figure>

<style>
  svg {
    display: block;
    width: 100%;
    max-width: 32rem;
    height: auto;
    margin-inline: auto;
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    background: var(--bg-elevated);
    font-family: var(--font-sans, system-ui);
  }

  rect {
    fill: var(--bg-elevated);
    stroke: var(--border);
  }

  .product {
    fill: var(--accent-soft);
    stroke: var(--accent);
  }

  path {
    fill: none;
    stroke: var(--text-muted);
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  text {
    fill: var(--text);
    font-size: 18px;
    font-weight: 600;
  }

  .enzyme {
    fill: var(--text-muted);
    font-family: var(--font-mono, monospace);
    font-size: 16px;
  }
</style>
