---
interface Props {
  n: number;
}
const { n } = Astro.props;
---

<sup class="font-serif text-[0.72em] font-semibold"
  ><a
    id={`cite-${n}`}
    href={`#ref-${n}`}
    class="text-[var(--accent)] no-underline hover:text-[var(--accent-strong)]"
    aria-label={`Reference ${n}`}>[{n}]</a
  ></sup
>
