---
interface Props {
  author?: string;
  updated: string;
  reviewed?: boolean;
}
const { author = 'melanocortin.com editorial', updated, reviewed = false } = Astro.props;
---

<div class="ui-sans mt-6 flex flex-wrap items-baseline gap-x-3 gap-y-1 text-xs tracking-wide text-[var(--text-muted)]">
  <span>
    By <span class="font-serif text-sm tracking-normal text-[var(--text)] italic">{author}</span>
  </span>
  <span class="text-[var(--accent)]" aria-hidden="true">·</span>
  <span>{reviewed ? 'Last reviewed' : 'Last updated'} {updated}</span>
</div>
