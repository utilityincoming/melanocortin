---
// Full site index from src/data/siteindex.ts.
//   variant="full"    → homepage: section headings + title + blurb per page
//   variant="compact" → footer: section headings + titles only
import { SITE_INDEX } from '../data/siteindex';

interface Props {
  variant?: 'full' | 'compact';
}
const { variant = 'full' } = Astro.props;
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
---

{
  variant === 'full' ? (
    <div class="mt-10 grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
      {SITE_INDEX.map((section) => (
        <section>
          <h3 class="font-mono text-xs uppercase tracking-[0.15em] text-[var(--accent)]">
            {section.title}
          </h3>
          <ul class="mt-4 space-y-4">
            {section.pages.map((p) => (
              <li>
                <a
                  href={p.href}
                  class="group block no-underline"
                  aria-current={p.href === path ? 'page' : undefined}
                >
                  <span class="font-medium text-[var(--text)] group-hover:text-[var(--accent)]">
                    {p.title}
                  </span>
                  <span class="mt-0.5 block text-sm leading-snug text-[var(--text-muted)]">
                    {p.blurb}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  ) : (
    <div class="grid gap-8 sm:grid-cols-3 lg:grid-cols-4">
      {SITE_INDEX.map((section) => (
        <section>
          <h3 class="font-mono text-[0.65rem] uppercase tracking-[0.15em] text-[var(--text)]">
            {section.title}
          </h3>
          <ul class="mt-3 space-y-1.5">
            {section.pages.map((p) => (
              <li>
                <a
                  href={p.href}
                  class="no-underline hover:text-[var(--accent)]"
                  aria-current={p.href === path ? 'page' : undefined}
                >
                  {p.title}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  )
}
