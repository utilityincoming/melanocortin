---
// "One template, three fates" — an original, self-contained diagram of the
// melanotan family. A single α-MSH template was re-engineered at Arizona into
// three molecules: Melanotan I (→ the approved drug afamelanotide), Melanotan II
// (the unapproved grey-market tanning peptide — this page's subject), and, by
// chasing Melanotan II's arousal side effect, PT-141 (→ the approved drug
// bremelanotide). Two of the three cleared trials; the middle one never did.
// Themed via CSS vars; static by design (a branching tree reads best still).
interface Props {
  caption?: boolean;
}
const { caption = true } = Astro.props;
---

<figure class="mt-family not-prose my-8">
  <svg
    viewBox="0 0 800 432"
    role="img"
    aria-labelledby="mtf-title mtf-desc"
    xmlns="http://www.w3.org/2000/svg"
  >
    <title id="mtf-title">The melanotan family — one template, three molecules</title>
    <desc id="mtf-desc"
      >One α-MSH template was re-engineered into three molecules. Melanotan I
      became the approved drug afamelanotide. Melanotan II is the unapproved
      grey-market tanning peptide. PT-141, carved from Melanotan II's arousal
      side effect, became the approved drug bremelanotide. Two of the three
      became medicines; Melanotan II did not.</desc
    >

    <!-- Template node -->
    <rect x="280" y="20" width="240" height="56" rx="14" class="tmpl" />
    <text x="400" y="45" text-anchor="middle" class="tmpl-name">α-MSH</text>
    <text x="400" y="63" text-anchor="middle" class="tmpl-sub">the body's own pigment signal</text>

    <!-- Stem + three branches -->
    <line x1="400" y1="76" x2="400" y2="102" class="stem" />
    <path d="M400 102 C400 126 130 116 130 138" class="branch" />
    <line x1="400" y1="102" x2="400" y2="138" class="branch" />
    <path d="M400 102 C400 126 670 116 670 138" class="branch" />

    <!-- LEFT — Melanotan I → afamelanotide (approved) -->
    <g>
      <rect x="16" y="138" width="228" height="266" rx="16" class="card" />
      <text x="130" y="166" text-anchor="middle" class="kicker">MELANOTAN I</text>
      <line x1="52" y1="176" x2="208" y2="176" class="rule" />
      <text x="130" y="206" text-anchor="middle" class="drug">Afamelanotide</text>
      <text x="130" y="228" text-anchor="middle" class="alias">Scenesse · approved 2019</text>
      <g class="pill pill-ok" transform="translate(130 262)">
        <rect x="-66" y="-16" width="132" height="30" rx="15" />
        <text x="0" y="4" text-anchor="middle">APPROVED MEDICINE</text>
      </g>
      <text x="130" y="316" text-anchor="middle" class="desc">MC1R · protective pigment</text>
      <text x="130" y="337" text-anchor="middle" class="desc-sub">for EPP light-sensitivity</text>
      <text x="130" y="376" text-anchor="middle" class="verdict verdict-ok">cleared trials ✓</text>
    </g>

    <!-- CENTRE — Melanotan II (this page) -->
    <g>
      <rect x="286" y="138" width="228" height="266" rx="16" class="card card-subject" />
      <text x="400" y="166" text-anchor="middle" class="kicker kicker-subject">MELANOTAN II</text>
      <line x1="322" y1="176" x2="478" y2="176" class="rule rule-subject" />
      <text x="400" y="206" text-anchor="middle" class="drug">The tanning peptide</text>
      <text x="400" y="228" text-anchor="middle" class="alias">MT-II · never approved</text>
      <g class="pill pill-warn" transform="translate(400 262)">
        <rect x="-66" y="-16" width="132" height="30" rx="15" />
        <text x="0" y="4" text-anchor="middle">GREY MARKET</text>
      </g>
      <text x="400" y="316" text-anchor="middle" class="desc">broad agonist · sunless tan</text>
      <text x="400" y="337" text-anchor="middle" class="desc-sub">unapproved everywhere</text>
      <text x="400" y="376" text-anchor="middle" class="verdict verdict-warn">never did ✗</text>
    </g>

    <!-- RIGHT — PT-141 → bremelanotide (approved) -->
    <g>
      <rect x="556" y="138" width="228" height="266" rx="16" class="card" />
      <text x="670" y="166" text-anchor="middle" class="kicker">PT-141</text>
      <line x1="592" y1="176" x2="748" y2="176" class="rule" />
      <text x="670" y="206" text-anchor="middle" class="drug">Bremelanotide</text>
      <text x="670" y="228" text-anchor="middle" class="alias">Vyleesi · approved 2019</text>
      <g class="pill pill-ok" transform="translate(670 262)">
        <rect x="-66" y="-16" width="132" height="30" rx="15" />
        <text x="0" y="4" text-anchor="middle">APPROVED MEDICINE</text>
      </g>
      <text x="670" y="316" text-anchor="middle" class="desc">MC4R · sexual desire</text>
      <text x="670" y="337" text-anchor="middle" class="desc-sub">carved from MT-II's side effect</text>
      <text x="670" y="376" text-anchor="middle" class="verdict verdict-ok">cleared trials ✓</text>
    </g>
  </svg>

  {
    caption && (
      <figcaption>
        One template, three fates. The same Arizona work on α-MSH produced{' '}
        <strong>Melanotan I</strong> (now the approved drug{' '}
        <strong>afamelanotide</strong>), the arousal drug{' '}
        <strong>bremelanotide</strong> (PT-141, carved out of Melanotan II), and{' '}
        <strong>Melanotan II</strong> itself — the only one of the three that never
        became a medicine, and the one sold on the grey market as a tanning peptide.
      </figcaption>
    )
  }
</figure>

<style>
  .mt-family {
    --ok: #2f7d4f;
    --warn: #b4532a;
    max-width: 46rem;
    margin-inline: auto;
  }
  @media (prefers-color-scheme: dark) {
    .mt-family {
      --ok: #5ec489;
      --warn: #e07a52;
    }
  }

  .mt-family svg {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    background: var(--bg-elevated);
    padding: 0.5rem;
  }

  /* template */
  .tmpl { fill: var(--accent-soft); stroke: var(--accent); stroke-width: 1.5; }
  .tmpl-name { font-size: 17px; font-weight: 700; fill: var(--text); }
  .tmpl-sub { font-size: 11px; fill: var(--text-muted); }

  /* connectors */
  .stem { stroke: var(--border); stroke-width: 2; }
  .branch { fill: none; stroke: var(--border); stroke-width: 2; }

  /* cards */
  .card { fill: var(--bg); stroke: var(--border); stroke-width: 1.5; }
  .card-subject { fill: var(--accent-soft); stroke: var(--accent-strong); stroke-width: 2.5; }

  .kicker {
    font-family: Consolas, 'Courier New', monospace;
    font-size: 11px; letter-spacing: 0.14em; fill: var(--text-muted);
  }
  .kicker-subject { fill: var(--accent-strong); font-weight: 600; }
  .rule { stroke: var(--border); stroke-width: 1; }
  .rule-subject { stroke: var(--accent-strong); opacity: 0.5; }

  .drug { font-size: 18px; font-weight: 700; fill: var(--text); }
  .alias { font-size: 11.5px; fill: var(--text-muted); }
  .desc { font-size: 12px; font-weight: 600; fill: var(--text); }
  .desc-sub { font-size: 11px; fill: var(--text-muted); }

  /* status pills */
  .pill rect { fill-opacity: 0.14; stroke-width: 1.5; }
  .pill text {
    font-family: Consolas, 'Courier New', monospace;
    font-size: 10.5px; letter-spacing: 0.06em; font-weight: 700;
  }
  .pill-ok rect { fill: var(--ok); stroke: var(--ok); }
  .pill-ok text { fill: var(--ok); }
  .pill-warn rect { fill: var(--warn); stroke: var(--warn); }
  .pill-warn text { fill: var(--warn); }

  .verdict { font-size: 12px; font-weight: 700; }
  .verdict-ok { fill: var(--ok); }
  .verdict-warn { fill: var(--warn); }

  figcaption {
    margin-top: 0.75rem;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--text-muted);
    text-align: center;
    max-width: 42rem;
    margin-inline: auto;
  }
  figcaption strong { color: var(--text); font-weight: 600; }
</style>
