---
// Recursive renderer for the POMC cleavage cascade (see src/data/pomc.ts).
// Each node is a button that opens a detail panel (wired by the page script).
// `needsPC2` is computed cumulatively down the tree: a node carries it if any
// PC2 cut lies on its path from POMC. The page toggles a tissue that does or
// doesn't carry PC2, and dims the nodes that can't be made there.
import type { PomcNode } from '../data/pomc';
import Self from './PomcTree.astro';

interface Props {
  nodes: PomcNode[];
  parentNeedsPC2?: boolean;
  depth?: number;
}
const { nodes, parentNeedsPC2 = false, depth = 0 } = Astro.props;
---

<ul class={depth === 0 ? 'pomc-tree not-prose' : 'pomc-subtree'}>
  {
    nodes.map((node) => {
      const needsPC2 = parentNeedsPC2 || node.enzyme === 'PC2';
      return (
        <li data-id={node.id} data-pc2={needsPC2 ? 'true' : 'false'}>
          <button type="button" class={`pomc-node cls-${node.nodeClass}`} data-node={node.id} aria-controls="pomc-detail" aria-pressed="false">
            <span class="pomc-name">{node.name}</span>
            {node.enzyme !== 'none' && (
              <span class={`enz ${node.enzyme === 'PC2' ? 'enz-pc2' : ''}`}>
                {node.enzyme}
              </span>
            )}
            <span class="pomc-tag">{node.tagline}</span>
            {needsPC2 && <span class="pomc-unavailable">Unavailable in this tissue</span>}
          </button>
          {node.children && node.children.length > 0 && (
            <Self nodes={node.children} parentNeedsPC2={needsPC2} depth={depth + 1} />
          )}
        </li>
      );
    })
  }
</ul>

<style>
  .pomc-tree,
  .pomc-subtree {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .pomc-subtree {
    --branch-indent: clamp(0.85rem, 3vw, 1.5rem);
    --branch-gap: 0.5rem;
    --branch-joint: calc(var(--branch-gap) + 1.25rem);
    margin-inline-start: 0.45rem;
  }

  .pomc-subtree > li {
    position: relative;
    padding-block-start: var(--branch-gap);
    padding-inline-start: var(--branch-indent);
  }

  /* Padding keeps each rail connected through the space between siblings. */
  .pomc-subtree > li::before {
    content: '';
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    border-inline-start: 1px solid var(--border);
  }

  .pomc-subtree > li::after {
    content: '';
    position: absolute;
    inset-block-start: var(--branch-joint);
    inset-inline-start: 0;
    inline-size: var(--branch-indent);
    border-block-start: 1px solid var(--border);
  }

  .pomc-subtree > li:last-child::before {
    inset-block-end: auto;
    block-size: var(--branch-joint);
  }

  .pomc-node {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0.1rem 0.6rem;
    width: 100%;
    max-width: 30rem;
    text-align: left;
    cursor: pointer;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-left-width: 3px;
    border-radius: 0.5rem;
    padding: 0.55rem 0.8rem;
    color: inherit;
    transition:
      border-color 0.15s,
      background-color 0.15s;
  }
  .pomc-node:hover {
    border-color: var(--accent);
    background: var(--accent-soft);
  }
  .pomc-node:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* class accents on the left border */
  .cls-precursor { border-left-color: var(--text-muted); }
  .cls-intermediate { border-left-color: var(--color-ink-400, var(--text-muted)); }
  .cls-melanocortin { border-left-color: var(--accent); }
  .cls-opioid { border-left-color: var(--color-pigment-300, var(--accent)); }
  .cls-other { border-left-color: var(--border); }

  .enz {
    grid-column: 2;
    align-self: start;
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.4;
    padding: 0.04rem 0.35rem;
    border: 1px solid var(--border);
    border-radius: 0.3rem;
    color: var(--text);
    white-space: nowrap;
  }

  .enz-pc2 {
    background: var(--accent-soft);
    border-color: var(--accent);
  }

  .pomc-name {
    font-weight: 650;
    font-size: 1rem;
    line-height: 1.3;
  }

  .pomc-tag,
  .pomc-unavailable {
    grid-column: 1 / -1;
    font-size: 0.8125rem;
    color: var(--text-muted);
    line-height: 1.35;
  }

  .pomc-unavailable { display: none; }

  :global(.pomc-tree.no-pc2) li[data-pc2='true'] > .pomc-node {
    border-block-style: dashed;
    border-inline-end-style: dashed;
  }

  :global(.pomc-tree.no-pc2) li[data-pc2='true'] > .pomc-node .pomc-unavailable {
    display: block;
    font-weight: 600;
  }

  .pomc-node[aria-pressed='true'] {
    border-color: var(--accent);
    background: var(--accent-soft);
  }

  @media (prefers-reduced-motion: reduce) {
    .pomc-node { transition: none; }
  }
</style>
