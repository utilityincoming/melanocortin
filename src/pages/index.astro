---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteIndex from '../components/SiteIndex.astro';
import { ALL_PAGES } from '../data/siteindex';

const receptors = [
  { id: 'MC1R', note: 'Skin & hair pigmentation' },
  { id: 'MC2R', note: 'Adrenal cortisol (the ACTH receptor)' },
  { id: 'MC3R', note: 'Energy balance & inflammation' },
  { id: 'MC4R', note: 'Appetite & body weight' },
  { id: 'MC5R', note: 'Exocrine gland function' },
];

const clinicalExamples = [
  {
    status: 'FDA-approved treatment',
    title: 'The skin remembers light',
    body: 'Pigment is part of how skin adapts to its environment. MC1R gives medicine a way into that response. For adults with erythropoietic protoporphyria, the benefit of afamelanotide can be measured in a human unit: more time in direct sunlight without pain.',
    href: '/afamelanotide',
    cta: 'Explore afamelanotide',
  },
  {
    status: 'Investigational',
    title: 'The quiet architecture of hormones',
    body: 'ACTH carries an instruction the adrenal gland reads through MC2R. In classic congenital adrenal hyperplasia, excess ACTH drives excess androgen production. Atumelnant is being studied to see whether blocking MC2R can reduce that burden.',
    href: '/atumelnant',
    cta: 'Explore MC2R blockade',
  },
  {
    status: 'FDA-approved treatment',
    title: 'Beyond the body’s usual range',
    body: 'A drug can change the strength, duration, or selectivity of signaling. In certain rare forms of obesity, setmelanotide activates MC4R directly, engaging the satiety pathway downstream of disrupted signaling.',
    href: '/setmelanotide',
    cta: 'Explore setmelanotide',
  },
];

const tools = [
  {
    href: '/explorer',
    title: 'Receptor–ligand explorer',
    body: 'Map which peptides and drugs act on which of the five receptors — agonist, antagonist, or inverse agonist — and what each interaction does.',
  },
  {
    href: '/selectivity',
    title: 'Selectivity visualizer',
    body: 'See how cleanly each ligand picks a single receptor — and the fold-gap that decides whether a clean single-target drug is even possible.',
  },
  {
    href: '/binding-matrix',
    title: 'The binding matrix',
    body: 'Every affinity value, receptor by receptor and ligand by ligand — each number traceable to the source it came from.',
  },
  {
    href: '/dose-curve',
    title: 'Dose & side-effect model',
    body: 'Why the concentration peak — not the dose — drives the nausea, and how switching delivery route changes it.',
  },
];

const pillars = [
  {
    href: '/system',
    kicker: 'Start here',
    title: 'The melanocortin system',
    body: 'How one precursor — POMC — becomes the peptides that signal across pigmentation, the stress axis, appetite, and inflammation. The whole map in one page.',
  },
  {
    href: '/receptors',
    kicker: 'Five switches',
    title: 'MC1R through MC5R',
    body: 'A page for each receptor: where it lives, what binds it, what it controls, and what breaks when it fails. The five levers the whole field is built on.',
  },
  {
    href: '/therapeutics',
    kicker: 'The frontier',
    title: 'Therapeutics & the pipeline',
    body: 'Approved and investigational melanocortin drugs — from setmelanotide and afamelanotide to the oral and anti-inflammatory agents opening the field wide.',
  },
];
---

<BaseLayout
  title="Melanocortin Science in Skin, Metabolism, and Endocrine Disease"
  description="Explore how melanocortin receptors shape pigmentation, appetite, and adrenal function, with cited guides to approved therapies and emerging research."
>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-0"
      style="background: radial-gradient(78% 95% at 18% -12%, var(--accent-soft), transparent 60%);"
      aria-hidden="true"
    >
    </div>
    <div class="relative mx-auto max-w-5xl px-6 pt-20 pb-16 sm:pt-28">
      <p class="font-mono text-xs uppercase tracking-[0.2em] text-[var(--accent)]">
        Melanocortin science · Skin, metabolism, and the endocrine axis
      </p>
      <h1 class="mt-5 max-w-3xl text-balance font-serif text-4xl leading-[1.1] font-semibold tracking-tight sm:text-6xl">
        Light on the skin.{' '}
        <span class="text-[var(--accent)]">A signal in the blood.</span>
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-[var(--text-muted)]">
        The skin keeps a record of light. The adrenal gland follows the rhythm
        of a hormone. In both, melanocortin receptors give a passing signal a
        consequence that can outlast it.
      </p>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-[var(--text-muted)]">
        A drug can sustain a protective signal, reach a receptor downstream of
        an interrupted pathway, or quiet an instruction the body sends in excess.
        Across skin, metabolism, and endocrine disease, the opportunity is to
        recover functions that matter in daily life.
      </p>
      <div class="mt-9 flex flex-wrap items-center gap-3">
        <a
          href="/system"
          class="ui-sans rounded-md bg-[var(--accent)] px-5 py-2.5 text-sm font-medium text-white no-underline transition-opacity hover:opacity-90"
        >
          Explore the biology
        </a>
        <a
          href="/pipeline"
          class="ui-sans rounded-md border border-[var(--border)] px-5 py-2.5 text-sm font-medium no-underline transition-colors hover:border-[var(--accent)] hover:text-[var(--accent)]"
        >
          Follow the clinical pipeline
        </a>
      </div>
    </div>
  </section>

  <!-- Receptors strip -->
  <section class="border-y border-[var(--border)] bg-[var(--bg-elevated)]">
    <div class="mx-auto grid max-w-5xl grid-cols-2 divide-x divide-y divide-[var(--border)] px-0 sm:grid-cols-5 sm:divide-y-0">
      {
        receptors.map((r) => (
          <a
            href={`/receptors/${r.id.toLowerCase()}`}
            class="group flex flex-col gap-1 px-6 py-7 no-underline transition-colors hover:bg-[var(--accent-soft)]"
          >
            <span class="font-mono text-lg font-semibold tracking-tight group-hover:text-[var(--accent)]">
              {r.id}
            </span>
            <span class="text-xs leading-snug text-[var(--text-muted)]">{r.note}</span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Clinical examples -->
  <section class="mx-auto max-w-5xl px-6 py-20">
    <h2 class="max-w-3xl font-serif text-3xl font-semibold tracking-tight">
      What changes when we change the signal?
    </h2>
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {
        clinicalExamples.map((example) => (
          <a href={example.href} class="plate group flex flex-col p-6 no-underline">
            <span class="font-mono text-xs uppercase tracking-wide text-[var(--accent)]">
              {example.status}
            </span>
            <h3 class="mt-2 font-serif text-xl font-semibold">{example.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-[var(--text-muted)]">{example.body}</p>
            <span class="mt-auto pt-4 text-sm font-medium text-[var(--accent)]">{example.cta} →</span>
          </a>
        ))
      }
    </div>
    <h3 class="mt-12 font-serif text-2xl font-semibold">What would it mean to get a function back?</h3>
    <p class="mt-3 max-w-2xl leading-relaxed text-[var(--text-muted)]">
      More time in daylight. Less of the day organized around an endocrine
      disorder. The path toward cure begins with a question specific to each
      disease. What could a patient get back, and how long could they keep it?
    </p>
    <a href="/pipeline" class="mt-4 inline-block text-[var(--accent)] quiet">
      Track the evidence →
    </a>
  </section>

  <!-- Pillars -->
  <section class="mx-auto max-w-5xl border-t border-[var(--border)] px-6 py-20">
    <h2 class="font-serif text-2xl font-semibold tracking-tight">From signal to treatment</h2>
    <p class="mt-2 max-w-2xl text-[var(--text-muted)]">
      Broad overviews that link down into specific, citeable detail — the
      system, the five receptors, and the drugs built on them.
    </p>
    <div class="mt-10 grid gap-6 sm:grid-cols-3">
      {
        pillars.map((p) => (
          <a
            href={p.href}
            class="plate group flex flex-col p-6 no-underline"
          >
            <span class="font-mono text-xs uppercase tracking-[0.15em] text-[var(--accent)]">
              {p.kicker}
            </span>
            <span class="mt-3 font-serif text-xl font-semibold tracking-tight">{p.title}</span>
            <span class="mt-2 text-sm leading-relaxed text-[var(--text-muted)]">{p.body}</span>
            <span class="mt-4 text-sm font-medium text-[var(--accent)]">Read →</span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Explore interactively -->
  <section class="mx-auto max-w-5xl border-t border-[var(--border)] px-6 py-20">
    <p class="font-mono text-xs uppercase tracking-[0.2em] text-[var(--accent)]">Explore the data</p>
    <h2 class="mt-3 font-serif text-2xl font-semibold tracking-tight">Explore the receptor data</h2>
    <p class="mt-2 max-w-2xl text-[var(--text-muted)]">
      Don't just read it — turn it over. Four views built straight from the
      cited data, for how the peptides, the drugs, and the five receptors
      actually fit together.
    </p>
    <div class="mt-10 grid gap-6 sm:grid-cols-2">
      {
        tools.map((t) => (
          <a
            href={t.href}
            class="plate group flex flex-col p-6 no-underline"
          >
            <span class="font-serif text-xl font-semibold tracking-tight">{t.title}</span>
            <span class="mt-2 text-sm leading-relaxed text-[var(--text-muted)]">{t.body}</span>
            <span class="mt-4 text-sm font-medium text-[var(--accent)]">Open the tool →</span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Every page: the full index -->
  <section class="mx-auto max-w-5xl border-t border-[var(--border)] px-6 py-20" aria-labelledby="site-index">
    <p class="font-mono text-xs uppercase tracking-[0.2em] text-[var(--accent)]">The whole map</p>
    <h2 id="site-index" class="mt-3 font-serif text-2xl font-semibold tracking-tight">
      Browse the reference
    </h2>
    <p class="mt-2 max-w-2xl text-[var(--text-muted)]">
      {ALL_PAGES.length} pages, each one cited: the system, the five receptors,
      the peptides that ride them, the drugs built on them, and the data that
      underpins every claim.
    </p>
    <SiteIndex variant="full" />
  </section>

  <!-- Editorial promise -->
  <section class="mx-auto max-w-5xl px-6 pb-4">
    <div class="border-l-2 border-[var(--accent)] py-1 pl-6">
      <h2 class="font-serif text-xl font-semibold tracking-tight">How we read the evidence</h2>
      <p class="mt-3 max-w-2xl leading-relaxed text-[var(--text)]">
        Every page identifies its author and shows when it was updated.
        Clinical claims link to their sources, and emerging or contested findings
        are identified as such.
      </p>
      <p class="mt-4 text-sm text-[var(--text-muted)]">
        This is an educational resource, not medical advice.{' '}
        <a href="/about" class="quiet">Read the editorial standards →</a>
      </p>
    </div>
  </section>
</BaseLayout>
