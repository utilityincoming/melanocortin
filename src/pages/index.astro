---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteIndex from '../components/SiteIndex.astro';
import { ALL_PAGES } from '../data/siteindex';
import { pipeline } from '../data/pipeline';

// Agents actively in clinical development (Phase 1+), excluding approved and
// discontinued programs. Derived from the pipeline data so the headline count
// can never drift from the page it points at.
const clinicCount = pipeline.filter((e) => e.status === 'active' && e.stage >= 1).length;

const receptors = [
  { id: 'MC1R', note: 'Skin & hair pigmentation' },
  { id: 'MC2R', note: 'Adrenal cortisol (the ACTH receptor)' },
  { id: 'MC3R', note: 'Energy balance & inflammation' },
  { id: 'MC4R', note: 'Appetite & body weight' },
  { id: 'MC5R', note: 'Exocrine gland function' },
];

const proof = [
  {
    stat: 'One gene',
    label: 'feeds five receptors',
    body: 'Tissue-specific cleavage of POMC generates the melanocortin peptides, while two endogenous antagonists — AGRP and ASIP — provide receptor-level inhibition.',
    href: '/system',
    cta: 'See the system',
  },
  {
    stat: '3 in 24 months',
    label: 'first-in-class approvals',
    body: 'Between 2019 and 2020, three targeted melanocortin drugs earned regulatory approval — for erythropoietic protoporphyria, hypoactive sexual desire disorder, and monogenic obesity.',
    href: '/therapeutics',
    cta: 'The approvals',
  },
  {
    stat: `${clinicCount} agents`,
    label: 'in active clinical trials',
    body: 'Development is shifting toward oral small molecules and biased agonists across obesity, dry eye disease, ulcerative colitis, and cancer cachexia.',
    href: '/pipeline',
    cta: 'The live pipeline',
  },
];

const tools = [
  {
    href: '/explorer',
    title: 'Receptor–ligand explorer',
    body: 'Map which peptides and drugs act on which of the five receptors — agonist, antagonist, or inverse agonist — and what each interaction does.',
  },
  {
    href: '/selectivity',
    title: 'Selectivity visualizer',
    body: 'See how cleanly each ligand picks a single receptor — and the fold-gap that decides whether a clean single-target drug is even possible.',
  },
  {
    href: '/binding-matrix',
    title: 'The binding matrix',
    body: 'Every affinity value, receptor by receptor and ligand by ligand — each number traceable to the source it came from.',
  },
  {
    href: '/dose-curve',
    title: 'Dose & side-effect model',
    body: 'See why peak plasma concentration — not total dose — drives melanocortin-induced nausea, and how delivery route alters the window.',
  },
];

const pillars = [
  {
    href: '/system',
    kicker: 'Start here',
    title: 'The melanocortin system',
    body: 'Follow how POMC is cleaved into α-, β-, and γ-MSH and ACTH, and how endogenous antagonists counterbalance receptor signaling.',
  },
  {
    href: '/receptors',
    kicker: 'Five targets',
    title: 'MC1R through MC5R',
    body: 'Examine MC1R through MC5R — tissue distribution, endogenous ligands, downstream cAMP signaling, and loss-of-function phenotypes.',
  },
  {
    href: '/therapeutics',
    kicker: 'Clinical translation',
    title: 'Therapeutics & the pipeline',
    body: 'Review approved drugs and investigational candidates, from injectable peptides to oral and gut-restricted small molecules.',
  },
];
---

<BaseLayout
  title="Melanocortin: the system, the five receptors, and the drugs"
  description="An open, citation-first field guide to the melanocortin system: POMC, the peptides it becomes, the MC1R–MC5R receptors, and the drugs built on them."
>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-0"
      style="background: radial-gradient(78% 95% at 18% -12%, var(--accent-soft), transparent 60%);"
      aria-hidden="true"
    >
    </div>
    <div class="relative mx-auto max-w-5xl px-6 pt-20 pb-16 sm:pt-28">
      <p class="font-mono text-xs uppercase tracking-[0.2em] text-[var(--accent)]">
        POMC → MC1R–MC5R · Melanocortin Pharmacology
      </p>
      <h1 class="mt-5 max-w-3xl font-serif text-4xl leading-[1.1] font-semibold tracking-tight sm:text-6xl">
        Five receptors. One precursor gene.{' '}
        <span class="text-[var(--accent)]">Reaching almost every organ system.</span>
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-[var(--text-muted)]">
        The melanocortin system regulates skin pigmentation, adrenal cortisol,
        appetite, and inflammatory resolution — yet remains unfamiliar outside
        endocrinology. Decades of receptor mapping are now translating into
        selective agonists, oral small molecules, and tissue-restricted therapies.
        This is an open, citation-first reference to the biology and the
        clinical pipeline.
      </p>
      <div class="mt-9 flex flex-wrap items-center gap-3">
        <a
          href="/system"
          class="rounded-md bg-[var(--accent)] px-5 py-2.5 text-sm font-medium text-white no-underline transition-opacity hover:opacity-90"
        >
          Explore the system
        </a>
        <a
          href="/therapeutics"
          class="rounded-md border border-[var(--border)] px-5 py-2.5 text-sm font-medium no-underline transition-colors hover:border-[var(--accent)] hover:text-[var(--accent)]"
        >
          View the clinical pipeline
        </a>
      </div>
    </div>
  </section>

  <!-- Receptors strip -->
  <section class="border-y border-[var(--border)] bg-[var(--bg-elevated)]">
    <div class="mx-auto grid max-w-5xl grid-cols-2 divide-x divide-y divide-[var(--border)] px-0 sm:grid-cols-5 sm:divide-y-0">
      {
        receptors.map((r) => (
          <a
            href={`/receptors/${r.id.toLowerCase()}`}
            class="group flex flex-col gap-1 px-6 py-7 no-underline transition-colors hover:bg-[var(--accent-soft)]"
          >
            <span class="font-mono text-lg font-semibold tracking-tight group-hover:text-[var(--accent)]">
              {r.id}
            </span>
            <span class="text-xs leading-snug text-[var(--text-muted)]">{r.note}</span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Why now: the clinical translation -->
  <section class="mx-auto max-w-5xl px-6 py-20">
    <p class="font-mono text-xs uppercase tracking-[0.2em] text-[var(--accent)]">Why now</p>
    <h2 class="mt-3 max-w-3xl font-serif text-3xl font-semibold tracking-tight">
      From basic endocrinology to a clinical drug class.
    </h2>
    <p class="mt-4 max-w-2xl leading-relaxed text-[var(--text-muted)]">
      The melanocortin receptors were cloned long before they could be drugged
      selectively. Because a single precursor gene — POMC — feeds five distinct
      receptors, early compounds triggered off-target nausea and pigmentation.
      Newer scaffolds are separating those effects.
    </p>
    <div class="mt-10 grid gap-6 sm:grid-cols-3">
      {
        proof.map((p) => (
          <a
            href={p.href}
            class="group flex flex-col rounded-lg border border-[var(--border)] bg-[var(--bg-elevated)] p-6 no-underline transition-colors hover:border-[var(--accent)]"
          >
            <span class="font-serif text-3xl font-semibold tracking-tight text-[var(--accent)]">
              {p.stat}
            </span>
            <span class="mt-1 text-sm font-medium">{p.label}</span>
            <span class="mt-3 text-sm leading-relaxed text-[var(--text-muted)]">{p.body}</span>
            <span class="mt-4 text-sm font-medium text-[var(--accent)]">{p.cta} →</span>
          </a>
        ))
      }
    </div>
    <p class="mt-8 max-w-2xl leading-relaxed text-[var(--text)]">
      Melanocortin pharmacology is still early, which is when an accurate map
      matters most. The{' '}
      <a href="/pipeline" class="text-[var(--accent)] underline decoration-dotted">live pipeline</a>{' '}
      tracks every active program by phase and primary source.
    </p>
  </section>

  <!-- Pillars -->
  <section class="mx-auto max-w-5xl border-t border-[var(--border)] px-6 py-20">
    <h2 class="font-serif text-2xl font-semibold tracking-tight">Three ways in</h2>
    <p class="mt-2 max-w-2xl text-[var(--text-muted)]">
      Broad overviews that link down into specific, citeable detail — the
      system, the five receptors, and the drugs built on them.
    </p>
    <div class="mt-10 grid gap-6 sm:grid-cols-3">
      {
        pillars.map((p) => (
          <a
            href={p.href}
            class="group flex flex-col rounded-lg border border-[var(--border)] bg-[var(--bg-elevated)] p-6 no-underline transition-colors hover:border-[var(--accent)]"
          >
            <span class="font-mono text-xs uppercase tracking-[0.15em] text-[var(--accent)]">
              {p.kicker}
            </span>
            <span class="mt-3 font-serif text-xl font-semibold tracking-tight">{p.title}</span>
            <span class="mt-2 text-sm leading-relaxed text-[var(--text-muted)]">{p.body}</span>
            <span class="mt-4 text-sm font-medium text-[var(--accent)]">Read →</span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Explore interactively -->
  <section class="mx-auto max-w-5xl border-t border-[var(--border)] px-6 py-20">
    <p class="font-mono text-xs uppercase tracking-[0.2em] text-[var(--accent)]">Explore the data</p>
    <h2 class="mt-3 font-serif text-2xl font-semibold tracking-tight">Interactive tools</h2>
    <p class="mt-2 max-w-2xl text-[var(--text-muted)]">
      Inspect the underlying pharmacology directly. Four interactive views built
      from cited binding and pharmacokinetic data.
    </p>
    <div class="mt-10 grid gap-6 sm:grid-cols-2">
      {
        tools.map((t) => (
          <a
            href={t.href}
            class="group flex flex-col rounded-lg border border-[var(--border)] bg-[var(--bg-elevated)] p-6 no-underline transition-colors hover:border-[var(--accent)]"
          >
            <span class="font-serif text-xl font-semibold tracking-tight">{t.title}</span>
            <span class="mt-2 text-sm leading-relaxed text-[var(--text-muted)]">{t.body}</span>
            <span class="mt-4 text-sm font-medium text-[var(--accent)]">Open the tool →</span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Every page: the full index -->
  <section class="mx-auto max-w-5xl border-t border-[var(--border)] px-6 py-20" aria-labelledby="site-index">
    <p class="font-mono text-xs uppercase tracking-[0.2em] text-[var(--accent)]">The whole map</p>
    <h2 id="site-index" class="mt-3 font-serif text-2xl font-semibold tracking-tight">
      Every page on the site
    </h2>
    <p class="mt-2 max-w-2xl text-[var(--text-muted)]">
      {ALL_PAGES.length} pages, each one cited: the system, the five receptors,
      the peptides that ride them, the drugs built on them, and the data that
      underpins every claim.
    </p>
    <SiteIndex variant="full" />
  </section>

  <!-- Editorial promise -->
  <section class="mx-auto max-w-5xl px-6 pb-4">
    <div class="rounded-lg border border-[var(--border)] bg-[var(--accent-soft)] p-8">
      <h2 class="font-serif text-xl font-semibold tracking-tight">Reverent on the science. Skeptical on the page.</h2>
      <p class="mt-3 max-w-2xl leading-relaxed text-[var(--text)]">
        Reverence only counts if it survives the citations. Every page carries a
        visible author and a last-updated date. Therapeutic and pipeline claims
        are checked against current sources before publication, and where the
        science is uncertain or contested, the page says so — rather than
        papering over it. When the frontier is genuinely unsettled, we call it
        the frontier, not a sure thing.
      </p>
      <p class="mt-4 text-sm text-[var(--text-muted)]">
        This is an educational resource, not medical advice.{' '}
        <a href="/about" class="underline decoration-dotted hover:text-[var(--accent)]">Read the editorial standards →</a>
      </p>
    </div>
  </section>
</BaseLayout>
