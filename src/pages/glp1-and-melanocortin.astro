import Cite from '../components/Cite.astro';
import References from '../components/References.astro';

const references = [
  {
    authors: 'Secher A, Jelsing J, Baquero AF, et al.',
    title: 'The arcuate nucleus mediates GLP-1 receptor agonist liraglutide-dependent weight loss.',
    source: 'J Clin Invest. 124(10):4473–4488.',
    year: '2014',
    url: 'https://pubmed.ncbi.nlm.nih.gov/25202980/',
  },
  {
    authors: 'Cone RD.',
    title: 'Anatomy and regulation of the central melanocortin system.',
    source: 'Nat Neurosci. 8(5):571–578.',
    year: '2005',
    url: 'https://pubmed.ncbi.nlm.nih.gov/15856065/',
  },
  {
    authors: 'Clément K, van den Akker E, Argente J, et al.',
    title: 'Efficacy and safety of setmelanotide, an MC4R agonist, in individuals with severe obesity due to LEPR or POMC deficiency: single-arm, open-label, multicentre, phase 3 trials.',
    source: 'Lancet Diabetes Endocrinol. 8(12):960–970.',
    year: '2020',
    url: 'https://pubmed.ncbi.nlm.nih.gov/33137293/',
  },
  {
