          <td class="py-2 pr-4 text-[var(--text)]">r allele (weaker effect)</td>
          <td class="py-2 text-[var(--text)]">Fair skin, reduced tanning; modest risk contribution</td>
        </tr>
        <tr>
          <td class="py-2 pr-4 font-medium text-[var(--text)]">R163Q</td>
          <td class="py-2 pr-4 text-[var(--text)]"><a href="https://www.ncbi.nlm.nih.gov/snp/rs885479" rel="noopener">rs885479 ↗</a></td>
          <td class="py-2 pr-4 text-[var(--text)]">r allele (weaker effect)</td>
          <td class="py-2 text-[var(--text)]">Common in European populations; small phenotypic effect</td>
        </tr>
