    { name: 'Dry eye syndrome', type: 'MedicalCondition', sameAs: ['https://en.wikipedia.org/wiki/Dry_eye_syndrome'] },
    { name: 'Alpha-melanocyte-stimulating hormone', type: 'MedicalEntity', sameAs: ['https://en.wikipedia.org/wiki/Alpha-melanocyte-stimulating_hormone'] },
