---
import PageLayout from '../layouts/PageLayout.astro';
import Cite from '../components/Cite.astro';
import References from '../components/References.astro';
import RelatedPages from '../components/RelatedPages.astro';
import FAQ from '../components/FAQ.astro';
import KeyTakeaways from '../components/KeyTakeaways.astro';
import { TIERS, CONDITIONS, DROPPED } from '../data/conditions';

const count = (t: string) => CONDITIONS.filter((c) => c.tier === t).length;

const faqs = [
  {
    q: 'What conditions are melanocortin drugs approved to treat?',
    a: 'Five, through three modern drugs: erythropoietic protoporphyria (afamelanotide); obesity from POMC, PCSK1 or LEPR deficiency, Bardet–Biedl syndrome and acquired hypothalamic obesity (setmelanotide); and hypoactive sexual desire disorder in premenopausal women (bremelanotide). An older ACTH preparation, repository corticotropin, also carries long-standing labels for infantile spasms, multiple-sclerosis relapses and sarcoidosis. The relapse and sarcoidosis uses have their own pages.',
  },
  {
    q: 'What conditions are melanocortin drugs being tested for?',
    a: 'In late-stage trials: X-linked protoporphyria, vitiligo, congenital adrenal hyperplasia and dry eye disease. In mid-stage trials: Cushing’s disease, cachexia, ulcerative colitis, rheumatoid arthritis, systemic sclerosis, membranous nephropathy and common obesity. None of these is an approved use, and several have already had a failed or mixed trial.',
  },
  {
    q: 'Why does one hormone system touch such different diseases?',
    a: 'Because the same few peptides are read by five receptors sitting in different tissues. MC1R is on pigment and immune cells, MC2R on the adrenal, MC3R and MC4R in the brain’s energy circuits, MC5R on exocrine glands. A skin disease, an obesity syndrome and an adrenal disorder can all be melanocortin conditions while having nothing else in common.',
  },
  {
    q: 'Does a melanocortin drug approved for one condition work for the others?',
    a: 'No. Each approval covers one specific condition, usually a rare one with a clearly identified break in the pathway. Setmelanotide, for example, works where the signal above MC4R is missing; it is not a treatment for common obesity. The tiers on this page are per condition for exactly that reason.',
  },
  {
    q: 'Is this page medical advice?',
    a: 'No. It is a map of where the evidence stands, kept for readers who want to understand the field. It gives no dosing, sourcing or treatment guidance. Diagnosis and treatment decisions belong with a clinician.',
  },
];

